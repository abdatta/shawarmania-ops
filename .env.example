# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Only the PUBLIC pair belongs in client configuration. The anon key is
# designed to be public — Row-Level Security is what protects the data.
#
# The Supabase service-role key bypasses RLS entirely and MUST NEVER appear
# here, in .env, or anywhere else the browser bundle can reach. Anything that
# needs it runs in an Edge Function, with the key held in Edge Function secrets.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Edge Function secrets are set with `supabase secrets set`, never exposed as
# Vite variables. Production requires all four; local development uses the
# committed test-only hook secret and Mailpit, so no real provider is needed.
# SEND_EMAIL_HOOK_SECRET=v1,whsec_<base64 secret from the Auth hook>
# RESEND_API_KEY=re_...
# RECOVERY_EMAIL_FROM=Shawarmania Ops <access@ops.shawarmania.in>
# OWNER_RECOVERY_REDIRECT_URL=https://ops.shawarmania.in/recover

# `supabase start` prints the local anon key. For staging and production, take
# it from the project's API settings — a separate Supabase project per
# environment, per docs/OPERATIONS.md.
