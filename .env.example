# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Only the PUBLIC pair belongs in client configuration. The anon key is
# designed to be public — Row-Level Security is what protects the data.
#
# The Supabase service-role key bypasses RLS entirely and MUST NEVER appear
# here, in .env, or anywhere else the browser bundle can reach. Anything that
# needs it runs in an Edge Function, with the key held in Edge Function secrets.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# `supabase start` prints the local anon key. For staging and production, take
# it from the project's API settings — a separate Supabase project per
# environment, per docs/OPERATIONS.md.

# Where the customer's receipt page is served, if not production.
#
# The receipt is a Cloudflare Worker on the brand domain, not part of this app,
# so Share has to be told where it is. Leave this unset for production. Point it
# at the Worker running locally to look at the page and download the PDF before
# the apex route exists:
#
#   VITE_RECEIPT_BASE_URL=http://127.0.0.1:8787
#
# Public either way -- it is the same URL the customer opens.
# VITE_RECEIPT_BASE_URL=
