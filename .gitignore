# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Environment and secrets — never commit these
.env
.env.*
!.env.example
*.key
*.pem
service-role*

# Supabase local development
.branches
.temp
supabase/.temp/
supabase/.branches/
supabase/.username-migration/

# Real business data — never commit
*.dump
*.sql.gz
backups/
exports/
seed-real*

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and cache output
coverage/
.nyc_output/
.vite/
.turbo/
*.tsbuildinfo
playwright-report/
test-results/

