{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "vite-plugin-pwa/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    // Edge Function modules import each other with the extension Deno requires,
    // and `src/lib/hyperpure-run-record.test.ts` pulls one of them into this
    // program to test it. Safe with `noEmit`, which this project already sets:
    // nothing is written, so no `.ts` specifier can survive into output.
    "allowImportingTsExtensions": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src",
    "e2e",
    "e2e-auth",
    "supabase/tests/rest",
    "ports.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.auth.config.ts",
    "vitest.rls.config.ts"
  ]
}
