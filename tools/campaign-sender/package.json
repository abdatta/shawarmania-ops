{
  "name": "shawarmania-campaign-sender",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Sends WhatsApp campaigns from the owner's laptop (a-campaign-goes-out-on-whatsapp). Not part of the PWA build.",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "check": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts check",
    "link": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts link",
    "sign-in": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts sign-in",
    "sign-out": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts sign-out",
    "install-startup": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts install-startup",
    "uninstall-startup": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts uninstall-startup",
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts start",
    "status": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts status",
    "stop": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts stop",
    "keep-running": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts keep-running",
    "test-send": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts test-send",
    "rehearse": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts rehearse",
    "restart": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts restart",
    "unlink": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/main.ts unlink",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5"
  }
}
